{
  "manifest_version": 3,
  "name": "LOS Companion Extension Template",
  "version": "2.0.0",
  "description": "Modular injection template that works with any web-based LOS.",
  "permissions": [
    "webNavigation",
    "tabs",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "*://*.your-los.example.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.your-los.example.com/*"],
      "js": ["config/los-config.js", "content/content.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open LOS Companion"
  }
}
